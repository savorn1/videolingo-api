JWT_SECRET=change-me-base64-encoded

SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=videolingo_db
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456

SEED_ADMIN_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123


AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=videolingo
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30

# Blank MAIL_HOST = log reset links to the console instead of emailing them.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=VideoLingo <no-reply@videolingo.local>

# AI (Claude API). Blank ANTHROPIC_API_KEY = AI features off.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
AI_MODEL=claude-opus-5
AI_FALLBACK_MODEL=claude-opus-4-8
AI_MONTHLY_BUDGET_USD=
AI_BUDGET_ENFORCED=false

# Processing pipeline — transcribe / translate / voice-over (dub) jobs.
# Needs yt-dlp and ffmpeg installed (brew install yt-dlp ffmpeg) for audio.
PIPELINE_ENABLED=true
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Speech-to-text (OpenAI Whisper)
OPENAI_API_KEY=
# Translation (OpenAI, same key as above)
OPENAI_TRANSLATION_MODEL=gpt-4.1
# Text-to-speech (OpenAI, same key as above)
OPENAI_TTS_MODEL=tts-1

# Signed, expiring links to stored files (see application.properties). Keep the
# bucket private: e.g. with MinIO, `mc anonymous set none <alias>/<bucket>`.
MEDIA_SIGNED_URLS=true
MEDIA_URL_TTL_MINUTES=180
